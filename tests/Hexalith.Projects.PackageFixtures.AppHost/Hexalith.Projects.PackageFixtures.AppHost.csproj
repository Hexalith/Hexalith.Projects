<Project Sdk="Aspire.AppHost.Sdk/17.0.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../references/Hexalith.Platform/DaprSelfHostedMtls.cs')">$(MSBuildThisFileDirectory)../../references/Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == ''">$(MSBuildThisFileDirectory)../../../Hexalith.Platform</HexalithPlatformRoot>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Projects.Integration.Tests" />
    <ProjectReference Include="../../src/Hexalith.Projects.Aspire/Hexalith.Projects.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../src/Hexalith.Projects.Server/Hexalith.Projects.Server.csproj" />
    <ProjectReference Include="../../src/Hexalith.Projects.UI/Hexalith.Projects.UI.csproj" />
    <ProjectReference Include="../../src/Hexalith.Projects.Workers/Hexalith.Projects.Workers.csproj" />
    <ProjectReference Include="../Hexalith.Projects.E2E.Fixtures/Hexalith.Projects.E2E.Fixtures.csproj" />
    <ProjectReference Include="../Hexalith.Projects.PackageFixtures/Hexalith.Projects.PackageFixtures.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore/Hexalith.EventStore.csproj" />
    <ProjectReference Include="$(HexalithTenantsRoot)/src/Hexalith.Tenants/Hexalith.Tenants.csproj" />
    <ProjectReference Include="$(HexalithFoldersRoot)/src/Hexalith.Folders.Server/Hexalith.Folders.Server.csproj" />
    <ProjectReference Include="$(HexalithFoldersRoot)/src/Hexalith.Folders.Workers/Hexalith.Folders.Workers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="Hexalith.EventStore.Aspire" />
    <PackageReference Include="YamlDotNet" />
    <PackageDownload Include="Hexalith.Builds.Module.Cli" Version="[4.48.2]" />
    <Reference Include="Hexalith.Builds.Tooling">
      <HintPath>$(NuGetPackageRoot)/hexalith.builds.module.cli/4.48.2/tools/net10.0/any/Hexalith.Builds.Tooling.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="$(HexalithPlatformRoot)/DaprSelfHostedMtls.cs" Link="Platform/DaprSelfHostedMtls.cs" />
    <Compile Include="$(HexalithPlatformRoot)/DaprSelfHostedMtlsSubscriber.cs" Link="Platform/DaprSelfHostedMtlsSubscriber.cs" />
  </ItemGroup>
</Project>
