<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants Condition="'$(SupportedProjectReadDistributed)' == 'true'">$(DefineConstants);SUPPORTED_PROJECT_READ_DISTRIBUTED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Projects.AppHost\Hexalith.Projects.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Projects.Aspire\Hexalith.Projects.Aspire.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Projects.Infrastructure\Hexalith.Projects.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Projects.Server\Hexalith.Projects.Server.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Projects.Testing\Hexalith.Projects.Testing.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Projects.Workers\Hexalith.Projects.Workers.csproj" />
    <ProjectReference Include="..\Hexalith.Projects.E2E.Fixtures\Hexalith.Projects.E2E.Fixtures.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SupportedProjectReadDistributed)' == 'true'">
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Testing/Hexalith.EventStore.Testing.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Testing" Condition="'$(UseHexalithProjectReferences)' != 'true'" />
  </ItemGroup>
  <!-- Package-mode structural tests compile the same pinned Platform helper without
       adding its unpublished source dependencies to any product project. -->
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../references/Hexalith.Platform/DaprSelfHostedMtls.cs')">$(MSBuildThisFileDirectory)../../references/Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../../Hexalith.Platform/DaprSelfHostedMtls.cs')">$(MSBuildThisFileDirectory)../../../Hexalith.Platform</HexalithPlatformRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <Compile Include="$(HexalithPlatformRoot)/DaprSelfHostedMtls.cs" Link="Platform/DaprSelfHostedMtls.cs" />
    <Compile Include="$(HexalithPlatformRoot)/DaprSelfHostedMtlsSubscriber.cs" Link="Platform/DaprSelfHostedMtlsSubscriber.cs" />
    <PackageDownload Include="Hexalith.Builds.Module.Cli" Version="[4.48.2]" />
    <Reference Include="Hexalith.Builds.Tooling">
      <HintPath>$(NuGetPackageRoot)/hexalith.builds.module.cli/4.48.2/tools/net10.0/any/Hexalith.Builds.Tooling.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
