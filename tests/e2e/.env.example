# URLs are discovered and exported by run-live-apphost.sh. Do not pin Aspire ports here.
KEYCLOAK_REALM=hexalith
KEYCLOAK_CLIENT_ID=hexalith-eventstore
TEST_USER_USERNAME=<local-realm-username>
TEST_USER_PASSWORD=<local-realm-password>

# Optional isolation override (1-64 characters of [A-Za-z0-9._-]). The managed runner generates a
# unique value by default and suffixes it per phase (-smoke, -full).
# E2E_RUN_ID=<unique-run-id>

# Optional bound, in seconds, for each managed `aspire wait` (default 600).
# E2E_RESOURCE_TIMEOUT_SECONDS=600
