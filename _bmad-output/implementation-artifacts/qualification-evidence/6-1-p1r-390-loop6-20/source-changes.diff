+    $noRuleIdPath = Join-Path $temporaryRoot 'no-rule-id.json'
+    Set-Content -LiteralPath $noRuleIdPath -Encoding utf8 -Value '{"status":"failed","outcome":{"exitCode":"UsageOrManifest","ruleId":null}}'
