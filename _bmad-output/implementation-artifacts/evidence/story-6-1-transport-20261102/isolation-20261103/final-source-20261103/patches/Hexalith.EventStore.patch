+using Hexalith.EventStore.Contracts.Routing;
+using Hexalith.EventStore.ServiceDefaults.Routing;
+
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+
+using NSubstitute;
+
+using Shouldly;
+
+namespace Hexalith.EventStore.Server.Tests.Routing;
+
+/// <summary>Proves host byte retention never retains admission authority or leaks into independent host operations.</summary>
+public sealed class HostMemoAdmissionTests
+{
+#if DEBUG
+    private static bool PrivateExpected => true;
+#else
+    private static bool PrivateExpected => false;
+#endif
+
+    /// <summary>Only explicit retention makes the first decode of a later acquisition warm; every scope is still new and closing.</summary>
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public async Task CrossAcquisitionBenefitRequiresExplicitPrivateOption(bool enabled)
+    {
+        var fixture = new RouteCatalogTestFixture();
+        await fixture.ActivateAsync(fixture.Candidate());
+        var scopes = new List<RouteCatalogDecodeScope?>();
+        var hits = new List<(int Hits, int Captures, bool Memo)>();
+        using RouteCatalogAuthority authority = Create(fixture, _ =>
+        {
+            var current = RouteCatalogDecodeScope.Current;
+            scopes.Add(current);
+            hits.Add((current?.CacheHits ?? 0, current?.CaptureCount ?? 0, current?.HasHostMemo == true));
+            return Task.FromResult(fixture.Observations[0]);
+        }, retain: enabled);
+        await using (var first = await authority.AcquireAsync()) { }
+        await using (var second = await authority.AcquireAsync()) { }
+        if (PrivateExpected)
+        {
+            scopes[0].ShouldNotBeSameAs(scopes[1]);
+            hits[0].Hits.ShouldBe(hits[0].Captures - 1);
+            hits[1].Memo.ShouldBe(enabled);
+            hits[1].Hits.ShouldBe(hits[1].Captures - (enabled ? 0 : 1));
+            scopes.All(scope => scope!.Count == 0 && scope.RetainedBytes == 0).ShouldBeTrue();
+        }
+        else scopes.ShouldAllBe(scope => scope == null);
+        (await fixture.Store.ReadAsync(default)).State.Leases.ShouldBeEmpty();
+    }
+
+    /// <summary>A nested disabled or independently enabled host cannot inherit A's active memo during acquisition or release.</summary>
+    [Theory]
+    [InlineData("disabled")]
+    [InlineData("scope-only")]
+    [InlineData("enabled")]
+    public async Task NestedForeignAcquisitionAndReleaseUseOnlyTheirOwnComputationContext(string mode)
+    {
+        var fixture = new RouteCatalogTestFixture();
+        await fixture.ActivateAsync(fixture.Candidate());
+        var foreignReads = new List<(RouteCatalogDecodeScope? Scope, bool Memo, int Count)>();
+        var foreignStore = Substitute.For<IRouteCatalogStateStore>();
+        foreignStore.Coordinates.Returns(fixture.Store.Coordinates);
+        foreignStore.ReadAsync(Arg.Any<CancellationToken>()).Returns(call =>
+        {
+            var current = RouteCatalogDecodeScope.Current;
+            foreignReads.Add((current, current?.HasHostMemo == true, current?.Count ?? 0));
+            return fixture.Store.ReadAsync(call.Arg<CancellationToken>());
+        });
+        foreignStore.CompareExchangeAsync(Arg.Any<RouteCatalogActivationState>(), Arg.Any<string>(), Arg.Any<CancellationToken>())
+            .Returns(call => fixture.Store.CompareExchangeAsync(call.Arg<RouteCatalogActivationState>(), call.Arg<string>(), call.Arg<CancellationToken>()));
+        using RouteCatalogAuthority foreign = Create(fixture, _ => Task.FromResult(fixture.Observations[0]),
+            retain: mode == "enabled", scoped: mode != "disabled", store: foreignStore);
+        bool nested = false;
+        RouteCatalogDecodeScope? outer = null;
+        using RouteCatalogAuthority first = Create(fixture, async _ =>
+        {
+            if (nested)
+            {
+                nested = false;
+                outer = RouteCatalogDecodeScope.Current;
+                int captures = outer?.CaptureCount ?? 0;
+                await using (var lease = await foreign.AcquireAsync().WaitAsync(TimeSpan.FromSeconds(5))) { }
+                RouteCatalogDecodeScope.Current.ShouldBeSameAs(outer);
+                (outer?.CaptureCount ?? 0).ShouldBe(captures);
+            }
+            return fixture.Observations[0];
+        });
+        await using (var seed = await first.AcquireAsync()) { }
+        nested = true;
+
+        await using (var next = await first.AcquireAsync().WaitAsync(TimeSpan.FromSeconds(5))) { }
+
+        foreignReads.Count.ShouldBe(2);
+        foreignReads[0].Count.ShouldBe(0); // A was warm; this exact separate host was not.
+        if (PrivateExpected && mode != "disabled") foreignReads[0].Scope.ShouldNotBeNull().ShouldNotBeSameAs(outer);
+        else foreignReads[0].Scope.ShouldBeNull();
+        foreignReads[0].Memo.ShouldBe(PrivateExpected && mode == "enabled");
+        foreignReads[1].Memo.ShouldBe(PrivateExpected && mode == "enabled");
+        if (mode != "enabled" || !PrivateExpected) foreignReads[1].Scope.ShouldBeNull();
+        else foreignReads[1].Scope.ShouldNotBeNull().ShouldNotBeSameAs(outer);
+        RouteCatalogDecodeScope.Current.ShouldBeNull();
+        (await fixture.Store.ReadAsync(default)).State.Leases.ShouldBeEmpty();
+    }
+
+    /// <summary>Warm identical document bytes never replace current epoch, catalog, local host or trust checks.</summary>
+    [Theory]
+    [InlineData("epoch")]
+    [InlineData("catalog")]
+    [InlineData("host")]
+    [InlineData("trust")]
+    [InlineData("different-bytes-same-root")]
+    public async Task ChangedAuthorityStillRevalidatesAfterEarlierScopeClosed(string changed)
+    {
+        var fixture = new RouteCatalogTestFixture();
+        RouteCatalogActivation initial = fixture.Candidate();
+        await fixture.ActivateAsync(initial);
+        bool changedHost = false;
+        using RouteCatalogAuthority authority = Create(fixture, _ => Task.FromResult(changedHost
+            ? fixture.Observations[0] with { AuthenticationProfile = "changed-authentication"u8.ToArray() } : fixture.Observations[0]));
+        await using (var seed = await authority.AcquireAsync()) { }
+        RouteCatalogActivation next = fixture.Candidate(2, initial.RootDigest);
+        var stored = await fixture.Store.ReadAsync(default);
+        var state = changed switch
+        {
+            "epoch" => stored.State with { Epoch = stored.State.Epoch + 1 },
+            "catalog" => stored.State with { Epoch = stored.State.Epoch + 1, Committed = next },
+            "trust" => stored.State with { Committed = initial with { TrustProof = "changed-proof" } },
+            "different-bytes-same-root" => stored.State with { Committed = initial with { CanonicalCatalog = next.CanonicalCatalog } },
+            _ => stored.State,
+        };
+        (await fixture.Store.CompareExchangeAsync(state, stored.ETag, default)).ShouldBeTrue();
+        changedHost = changed == "host";
+
+        if (changed == "different-bytes-same-root")
+            (await Should.ThrowAsync<RouteCatalogValidationException>(() => authority.AcquireAsync()))
+                .Diagnostics.Single().Code.ShouldBe("root-digest-mismatch");
+        else if (changed is "host" or "trust") await Should.ThrowAsync<RouteCatalogUnavailableException>(() => authority.AcquireAsync());
+        else
+        {
+            await using var lease = await authority.AcquireAsync();
+            lease.Snapshot.Epoch.ShouldBe(2);
+            lease.Snapshot.RootDigest.ShouldBe(changed == "catalog" ? next.RootDigest : initial.RootDigest);
+        }
+        (await fixture.Store.ReadAsync(default)).State.Leases.ShouldBeEmpty();
+    }
+
+    /// <summary>Host disposal clears only deterministic bytes; an existing fence can still complete, followed by fresh uncached admission.</summary>
+    [Fact]
+    public async Task DisposalPreservesInFlightFenceCleanupAndFreshFallback()
+    {
+        var fixture = new RouteCatalogTestFixture();
+        await fixture.ActivateAsync(fixture.Candidate());
+        var borrowed = new List<bool>();
+        using RouteCatalogAuthority authority = Create(fixture, _ =>
+        {
+            borrowed.Add(RouteCatalogDecodeScope.Current?.HasHostMemo == true);
+            return Task.FromResult(fixture.Observations[0]);
+        });
+        RouteCatalogDispatchLease lease = await authority.AcquireAsync();
+        var memo = (RouteCatalogValidatedBytesMemo)typeof(RouteCatalogAuthority).GetField("_validatedBytes",
+            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!.GetValue(authority)!;
+        memo.Count.ShouldBe(PrivateExpected ? 1 : 0);
+        var fence = (await fixture.Store.ReadAsync(default)).State.Leases.Single();
+
+        authority.Dispose();
+
+        memo.IsClosed.ShouldBeTrue();
+        memo.Count.ShouldBe(0);
+        memo.RetainedBytes.ShouldBe(0);
+        (await fixture.Store.ReadAsync(default)).State.Leases.Single().ShouldBe(fence);
+        await lease.DisposeAsync();
+        (await fixture.Store.ReadAsync(default)).State.Leases.ShouldBeEmpty();
+        await using (var fallback = await authority.AcquireAsync()) { }
+        borrowed.ShouldBe([PrivateExpected, false]);
+        memo.Count.ShouldBe(0);
+    }
+
+    private static RouteCatalogAuthority Create(RouteCatalogTestFixture fixture,
+        Func<CancellationToken, Task<RouteCatalogHostObservation>> capture, bool retain = true, bool scoped = true,
+        IRouteCatalogStateStore? store = null)
+    {
+        var options = Options.Create(new RouteCatalogHostOptions { Identity = fixture.Hosts[0], Profile = "Development",
+            DevelopmentFixture = true, RequireTechnicalHttpBinding = true, ScopedDecodeReuse = scoped,
+            SerializeLocalLeaseRelease = true, RetainValidatedCatalogBytes = retain });
+        IHostEnvironment environment = Substitute.For<IHostEnvironment>();
+        environment.EnvironmentName.Returns(Environments.Development);
+        return new(store ?? fixture.Store, new DevelopmentRouteCatalogTrustValidator(options, environment), options,
+            new ObservedRouteCatalogHost(capture), environment: environment);
+    }
+}
diff --git a/tests/Hexalith.EventStore.Server.Tests/Routing/HostValidatedCatalogBytesMemoTests.cs b/tests/Hexalith.EventStore.Server.Tests/Routing/HostValidatedCatalogBytesMemoTests.cs
new file mode 100644
index 000000000..4269aad1d
--- /dev/null
+++ b/tests/Hexalith.EventStore.Server.Tests/Routing/HostValidatedCatalogBytesMemoTests.cs
@@ -0,0 +1,178 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+using Hexalith.EventStore.Contracts.Routing;
+
+using Shouldly;
+
+namespace Hexalith.EventStore.Server.Tests.Routing;
+
+/// <summary>Checks exact-byte document facts across independent scopes without retaining graphs or authority.</summary>
+public sealed class HostValidatedCatalogBytesMemoTests
+{
+    /// <summary>A fresh scope benefits only from its explicitly supplied owner's bytes and always returns a fresh graph.</summary>
+    [Fact]
+    public void IndependentScopesReuseOnlyOwnedCanonicalBytesAndCheckEveryExpectedRoot()
+    {
+        byte[][] documents = Documents(2);
+        byte[] input = documents[0].ToArray();
+        string root = Hash(input);
+        using var memo = new RouteCatalogValidatedBytesMemo();
+        RouteCatalogEnvelope prior;
+        var first = RouteCatalogDecodeScope.EnterWithMemo(memo);
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(input, new string('0', 64)))
+            .Diagnostics.Single().Code.ShouldBe("root-digest-mismatch");
+        memo.Count.ShouldBe(0);
+        prior = RouteCatalogCodec.Decode(input, root);
+        first.CacheHits.ShouldBe(0);
+        first.Dispose();
+        first.Count.ShouldBe(0);
+        first.RetainedBytes.ShouldBe(0);
+        memo.Count.ShouldBe(1);
+        ((IList<RouteCatalogEntry>)prior.Routes)[0] = prior.Routes[0] with { AppId = "mutated-output" };
+        input[0] = (byte)'[';
+        using var second = RouteCatalogDecodeScope.EnterWithMemo(memo);
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(input, root));
+        input[0] = (byte)'{';
+        RouteCatalogEnvelope fresh = RouteCatalogCodec.Decode(input, root);
+        fresh.Routes.ShouldNotBeSameAs(prior.Routes);
+        fresh.Routes[0].AppId.ShouldNotBe("mutated-output");
+        RouteCatalogCodec.Encode(fresh).ShouldBe(input);
+        second.CacheHits.ShouldBe(1);
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(input, new string('0', 64)))
+            .Diagnostics.Single().Code.ShouldBe("root-digest-mismatch");
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(documents[1], root))
+            .Diagnostics.Single().Code.ShouldBe("root-digest-mismatch");
+        memo.Count.ShouldBe(1);
+        byte[] noncanonical = [.. " "u8, .. input];
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(noncanonical, new string('0', 64)))
+            .Diagnostics.Single().Code.ShouldBe("noncanonical-encoding");
+        byte[] unknown = Encoding.UTF8.GetBytes("{\"unknown\":null," + Encoding.UTF8.GetString(input)[1..]);
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(unknown, root))
+            .Diagnostics.Single().Code.ShouldBe("invalid-json-or-closed-schema");
+        RouteCatalogCodec.Decode(documents[1], Hash(documents[1])).Generation.ShouldBe(2);
+        memo.Count.ShouldBe(2);
+    }
+
+    /// <summary>Closed borrowed scopes cannot use an open host's memo, and closing the owner permanently clears retained bytes.</summary>
+    [Fact]
+    public async Task ClosedScopeAndDisposedOwnerCannotReuseOrRepopulateBytes()
+    {
+        byte[] bytes = Documents(1)[0];
+        var memo = new RouteCatalogValidatedBytesMemo();
+        var scope = RouteCatalogDecodeScope.EnterWithMemo(memo);
+        RouteCatalogCodec.Decode(bytes);
+        var go = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        Task escaped = Task.Run(async () =>
+        {
+            await go.Task;
+            RouteCatalogDecodeScope.Current.ShouldBeSameAs(scope);
+            scope.HasHostMemo.ShouldBeFalse();
+            RouteCatalogCodec.Decode(bytes, Hash(bytes));
+            scope.CaptureCount.ShouldBe(0);
+            scope.CacheHits.ShouldBe(0);
+        });
+        scope.Dispose();
+        memo.Count.ShouldBe(1);
+        go.SetResult();
+        await escaped;
+        memo.Dispose();
+        memo.IsClosed.ShouldBeTrue();
+        memo.Count.ShouldBe(0);
+        memo.RetainedBytes.ShouldBe(0);
+        using var after = RouteCatalogDecodeScope.EnterWithMemo(memo);
+        RouteCatalogCodec.Decode(bytes, Hash(bytes));
+        after.HasHostMemo.ShouldBeFalse();
+        after.CacheHits.ShouldBe(0);
+        memo.Count.ShouldBe(0);
+        Should.Throw<RouteCatalogValidationException>(() => RouteCatalogCodec.Decode(bytes, new string('0', 64)));
+    }
+
+    /// <summary>Independent concurrent scopes have fresh graphs, while unrelated owner memos remain cold.</summary>
+    [Fact]
+    public async Task ConcurrentAndForeignOwnersDoNotShareGraphsOrImplicitEntries()
+    {
+        byte[] bytes = Documents(1)[0];
+        using var owner = new RouteCatalogValidatedBytesMemo();
+        using (var seed = RouteCatalogDecodeScope.EnterWithMemo(owner)) RouteCatalogCodec.Decode(bytes);
+        RouteCatalogEnvelope[] results = await Task.WhenAll(Enumerable.Range(0, 12).Select(_ => Task.Run(() =>
+        {
+            using var scope = RouteCatalogDecodeScope.EnterWithMemo(owner);
+            RouteCatalogEnvelope result = RouteCatalogCodec.Decode(bytes, Hash(bytes));
+            scope.CacheHits.ShouldBe(1);
+            return result;
+        })));
+        results[0].Routes.ShouldNotBeSameAs(results[1].Routes);
+        using var outer = RouteCatalogDecodeScope.EnterWithMemo(owner);
+        using var foreign = new RouteCatalogValidatedBytesMemo();
+        using (var nested = RouteCatalogDecodeScope.EnterWithMemo(foreign))
+        {
+            nested.Count.ShouldBe(0);
+            RouteCatalogCodec.Decode(bytes);
+            nested.CacheHits.ShouldBe(0);
+        }
+        RouteCatalogDecodeScope.Current.ShouldBeSameAs(outer);
+        using (RouteCatalogDecodeScope.Suppress())
+        {
+            RouteCatalogDecodeScope.Current.ShouldBeNull();
+            RouteCatalogCodec.Decode(bytes);
+            outer.CaptureCount.ShouldBe(0);
+        }
+        RouteCatalogDecodeScope.Current.ShouldBeSameAs(outer);
+    }
+
+    /// <summary>Entry bounds apply across scope lifetimes and cannot affect successful uncached validation.</summary>
+    [Fact]
+    public void EntriesStayBoundedAcrossIndependentScopes()
+    {
+        byte[][] documents = Documents(4);
+        using var memo = new RouteCatalogValidatedBytesMemo();
+        foreach (byte[] bytes in documents)
+        {
+            using var scope = RouteCatalogDecodeScope.EnterWithMemo(memo);
+            RouteCatalogCodec.Decode(bytes, Hash(bytes));
+        }
+        memo.Count.ShouldBe(3);
+        memo.RetainedBytes.ShouldBe(documents.Take(3).Sum(bytes => bytes.Length));
+        using var final = RouteCatalogDecodeScope.EnterWithMemo(memo);
+        RouteCatalogCodec.Decode(documents[3], Hash(documents[3])).Generation.ShouldBe(4);
+        final.CacheHits.ShouldBe(0);
+    }
+
+    /// <summary>The hard byte bound is enforced on real valid canonical schema documents across independent scopes.</summary>
+    [Fact]
+    public void RealLargeDocumentsCannotExceedOwnedByteLimit()
+    {
+        var fixture = new RouteCatalogTestFixture(compiledSchemaThree: true);
+        using JsonDocument schema = JsonDocument.Parse(JsonSerializer.Serialize(new { description = new string('x', 3 * 1024 * 1024) }));
+        RouteOperationContract operation = fixture.Envelope.Operations![0] with { RequestSchema = schema.RootElement.Clone() };
+        operation = operation with { Digest = RouteCatalogCodec.ComputeOperationContractDigest(operation) };
+        using var memo = new RouteCatalogValidatedBytesMemo();
+        var lengths = new List<int>();
+        for (int generation = 1; generation <= 3; generation++)
+        {
+            RouteCatalogEnvelope envelope = RouteCatalogCodec.Decode(fixture.Candidate(generation).CanonicalCatalog);
+            envelope = envelope with
+            {
+                Operations = envelope.Operations!.Select(item => item.RouteId == operation.RouteId ? operation : item).ToArray(),
+                Routes = envelope.Routes.Select(item => item.RouteId == operation.RouteId ? item with { OperationContractDigest = operation.Digest } : item).ToArray(),
+            };
+            byte[] bytes = RouteCatalogCodec.Encode(RouteCatalogCodec.Seal(envelope));
+            lengths.Add(bytes.Length);
+            using var scope = RouteCatalogDecodeScope.EnterWithMemo(memo);
+            RouteCatalogCodec.Decode(bytes, Hash(bytes)).Generation.ShouldBe(generation);
+        }
+        memo.Count.ShouldBe(2);
+        memo.RetainedBytes.ShouldBe(lengths.Take(2).Sum());
+        memo.RetainedBytes.ShouldBeLessThanOrEqualTo(8 * 1024 * 1024);
+    }
+
+    private static byte[][] Documents(int count)
+    {
+        var fixture = new RouteCatalogTestFixture();
+        return Enumerable.Range(1, count).Select(generation => fixture.Candidate(generation).CanonicalCatalog).ToArray();
+    }
+
+    private static string Hash(byte[] bytes) => Convert.ToHexStringLower(SHA256.HashData(bytes));
+}
