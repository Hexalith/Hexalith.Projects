+using System.Text.Json;
+
+using Hexalith.EventStore.Contracts.Routing;
+
+namespace Hexalith.EventStore.Contracts.Tests.Routing;
+
+/// <summary>Pins the existing canonical writer's ordinal Unicode and stable equal-name behavior in embedded schemas.</summary>
+public sealed class RouteCatalogCanonicalOrderingTests
+{
+    /// <summary>Sorted and unsorted inputs retain the digests produced by the original stable-sort codec.</summary>
+    [Theory]
+    [InlineData("{\"é\":{\"z\":1,\"a\":2},\"a\":[1,null,true],\"😀\":{\"\\uE000\":\"b\",\"😀\":\"a\"},\"z\":0}", "b72ba566a94102891e71396ee2c3ce9daf4a724a3aa690ef082cdf1088ce5d7a")]
+    [InlineData("{\"a\":[1,null,true],\"z\":0,\"é\":{\"a\":2,\"z\":1},\"😀\":{\"😀\":\"a\",\"\\uE000\":\"b\"}}", "b72ba566a94102891e71396ee2c3ce9daf4a724a3aa690ef082cdf1088ce5d7a")]
+    [InlineData("{\"z\":0,\"a\":1,\"a\":2}", "d5eef3b57fd1f66db56b91f611054f92cace7be5fb0709bd71b5a6e8cc37ae84")]
+    [InlineData("{\"a\":1,\"a\":2,\"z\":0}", "d5eef3b57fd1f66db56b91f611054f92cace7be5fb0709bd71b5a6e8cc37ae84")]
+    [InlineData("{\"a\":2,\"a\":1,\"z\":0}", "e8125b6d9f49c007e201fafc566bb82f6dd1c798f40c096010b48e8fdc215ffe")]
+    public void EmbeddedSchemaMatchesPriorCanonicalDigest(string schema, string expected)
+    {
+        using JsonDocument input = JsonDocument.Parse(schema);
+        using JsonDocument output = JsonDocument.Parse("{}");
+        var operation = new RouteOperationContract("codec-order", "v1", "public", "agent-eligible",
+            input.RootElement, output.RootElement, "", "query", "sample", "GetSample");
+
+        RouteCatalogCodec.ComputeOperationContractDigest(operation).ShouldBe(expected);
+    }
+}
diff --git a/tests/Hexalith.EventStore.DomainService.Tests/BoundOwnerMetadataCaptureHandler.cs b/tests/Hexalith.EventStore.DomainService.Tests/BoundOwnerMetadataCaptureHandler.cs
new file mode 100644
index 000000000..231e5184f
--- /dev/null
+++ b/tests/Hexalith.EventStore.DomainService.Tests/BoundOwnerMetadataCaptureHandler.cs
@@ -0,0 +1,43 @@
+using System.Net;
+using System.Net.Http.Json;
+using Hexalith.EventStore.Client.Gateway;
+using Hexalith.EventStore.Client.Streams;
+using Hexalith.EventStore.Contracts.Identity;
+using Hexalith.EventStore.Contracts.Streams;
+
+namespace Hexalith.EventStore.DomainService.Tests;
+
+/// <summary>Captures only the test-owned metadata transport and exact owner proof.</summary>
+/// <param name="publicKey">The test owner public verification key.</param>
+internal sealed class BoundOwnerMetadataCaptureHandler(string publicKey) : HttpMessageHandler
+{
+    /// <summary>Gets or sets the calls control.</summary>
+    internal int Calls { get; private set; }
+    /// <summary>Gets or sets the valid proof control.</summary>
+    internal bool ValidProof { get; private set; }
+    /// <summary>Gets or sets the metadata only control.</summary>
+    internal bool MetadataOnly { get; private set; }
+    /// <summary>Gets or sets the path control.</summary>
+    internal string? Path { get; private set; }
+    /// <summary>Gets or sets the assertion control.</summary>
+    internal string? Assertion { get; private set; }
+    /// <summary>Gets or sets the mode control.</summary>
+    internal string Mode { get; set; } = "valid";
+
+    /// <inheritdoc/>
+    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+    {
+        Calls++;
+        Path = request.RequestUri!.AbsolutePath;
+        Assertion = request.Headers.GetValues("X-Hexalith-Workload-Assertion").Single();
+        var body = (await request.Content!.ReadFromJsonAsync<StreamReadRequest>(cancellationToken))!;
+        MetadataOnly = body.FromSequence == 0 && body.ToSequence == 0 && body.PageSize == 1 && body.RequireNativeProof;
+        ValidProof = BoundStreamReadProof.Verify(request.Headers.GetValues(BoundStreamReadProof.HeaderName).Single(), body,
+            "folders", publicKey, DateTimeOffset.UtcNow);
+        var identity = new AggregateIdentity(body.Tenant, body.Domain, body.AggregateId!);
+        var proof = NativeSourceProofCodec.CreateSeed(identity, "01ARZ3NDEKTSV4RRFFQ69G5FAV");
+        var page = new StreamReadPage(Mode == "wrong-tenant" ? "foreign" : body.Tenant, body.Domain, body.AggregateId, [],
+            new(0, 0, null, 0, 0, false, null) { NativeProof = Mode == "missing-proof" ? null : proof });
+        return new(Mode == "denied" ? HttpStatusCode.Forbidden : HttpStatusCode.OK) { Content = JsonContent.Create(page) };
+    }
+}
