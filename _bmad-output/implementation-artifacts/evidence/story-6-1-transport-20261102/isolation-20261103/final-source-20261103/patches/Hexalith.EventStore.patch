@@ -0,0 +1,51 @@
+using Hexalith.EventStore.ServiceDefaults.Authentication;
+using Hexalith.EventStore.ServiceDefaults.Routing;
+
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+
+namespace Hexalith.EventStore.Testing.CatalogInvocation;
+
+/// <summary>Explicit local Debug/Development-only activation, absent from normal executable references.</summary>
+public static class CatalogInvocationServiceCollectionExtensions
+{
+    /// <summary>Enrolls a private worker only when the exact profile is explicitly enabled.</summary>
+    /// <param name="services">Actual gateway services.</param>
+    /// <param name="configuration">Host-owned configuration.</param>
+    /// <param name="environment">Actual host environment.</param>
+    /// <returns>The services.</returns>
+    public static IServiceCollection AddPrivateCatalogInvocation(this IServiceCollection services,
+        IConfiguration configuration, IHostEnvironment environment)
+    {
+        ArgumentNullException.ThrowIfNull(services);
+        ArgumentNullException.ThrowIfNull(configuration);
+        ArgumentNullException.ThrowIfNull(environment);
+        const string prefix = "EventStore:Testing:CatalogInvocation";
+        if (!configuration.GetValue<bool>(prefix + ":Enabled")) return services;
+#if !DEBUG
+        throw new InvalidOperationException("Private catalog invocation requires a Debug build.");
+#else
+        if (!environment.IsDevelopment()) throw new InvalidOperationException("Private catalog invocation requires Development.");
+        CatalogInvocationOptions selection = configuration.GetSection(prefix).Get<CatalogInvocationOptions>()
+            ?? throw new InvalidOperationException("Missing private invocation selection.");
+        static bool AppId(string value) => value.Length is > 0 and <= 64
+            && value.All(character => char.IsAsciiLetterLower(character) || char.IsAsciiDigit(character) || character == '-');
+        if (selection.MetadataAppIds.Length is < 1 or > 8 || selection.MetadataAppIds.Any(value => !AppId(value))
+            || selection.MetadataAppIds.Distinct(StringComparer.Ordinal).Count() != selection.MetadataAppIds.Length
+            || !AppId(selection.ProjectionAppId) || !selection.MetadataAppIds.Contains(selection.ProjectionAppId, StringComparer.Ordinal))
+            throw new InvalidOperationException("Private invocation requires finite selected owners.");
+        _ = new CatalogInvocationFiles(selection.Directory);
+        string endpointText = configuration["DAPR_HTTP_ENDPOINT"] ?? "http://127.0.0.1:" + configuration["DAPR_HTTP_PORT"];
+        if (!Uri.TryCreate(endpointText, UriKind.Absolute, out Uri? endpoint) || !endpoint.IsLoopback
+            || endpoint.Scheme != "http" || endpoint.AbsolutePath != "/" || endpoint.UserInfo.Length != 0
+            || endpoint.Query.Length != 0 || endpoint.Fragment.Length != 0 || endpoint.Port <= 0)
+            throw new InvalidOperationException("The private worker requires the actual local Dapr HTTP endpoint.");
+        services.AddSingleton<IHostedService>(provider => new CatalogInvocationWorker(selection,
+            provider.GetRequiredService<IRouteCatalogAuthority>(), provider.GetRequiredService<IOptions<RouteCatalogHostOptions>>(),
+            provider.GetRequiredService<IWorkloadAssertionIssuer>(), endpoint));
+        return services;
+#endif
+    }
+}
diff --git a/src/Hexalith.EventStore.Testing/CatalogInvocation/CatalogInvocationWorker.cs b/src/Hexalith.EventStore.Testing/CatalogInvocation/CatalogInvocationWorker.cs
new file mode 100644
index 000000000..72f52920d
--- /dev/null
+++ b/src/Hexalith.EventStore.Testing/CatalogInvocation/CatalogInvocationWorker.cs
@@ -0,0 +1,150 @@
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+
+using Hexalith.EventStore.ServiceDefaults.Authentication;
+using Hexalith.EventStore.ServiceDefaults.Routing;
+
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+
+namespace Hexalith.EventStore.Testing.CatalogInvocation;
+
+/// <summary>Finite private callbacks from the actual enrolled gateway; no HTTP relay or factory filters.</summary>
+internal sealed class CatalogInvocationWorker : BackgroundService
+{
+    private readonly CatalogInvocationFiles _files;
+    private readonly CatalogInvocationOptions _selection;
+    private readonly IWorkloadAssertionIssuer _issuer;
+    private readonly Uri _endpoint;
+    private readonly HttpClient _http;
+
+    /// <summary>Uses only the real selected gateway authority, issuer and owned local Dapr endpoint.</summary>
+    /// <param name="selection">The finite private proof selection.</param>
+    /// <param name="authority">The actual enrolled gateway authority.</param>
+    /// <param name="catalog">The actual local catalog options.</param>
+    /// <param name="issuer">The gateway's real configured issuer.</param>
+    /// <param name="endpoint">The actual owned Dapr endpoint.</param>
+    internal CatalogInvocationWorker(CatalogInvocationOptions selection, IRouteCatalogAuthority authority,
+        IOptions<RouteCatalogHostOptions> catalog, IWorkloadAssertionIssuer issuer, Uri endpoint)
+    {
+        _selection = selection;
+        _files = new(selection.Directory);
+        _issuer = issuer;
+        _endpoint = endpoint;
+        if (catalog.Value is not { DevelopmentFixture: true, Profile: "Development", RequireTechnicalHttpBinding: true })
+            throw new InvalidOperationException("Private invocation requires the real selected Development catalog.");
+        // Deliberately constructed: the factory's workload filter must never replace negative credentials.
+        _http = new(new RouteCatalogInvocationHandler(authority,
+            new SocketsHttpHandler { AllowAutoRedirect = false }, catalog)) { Timeout = Timeout.InfiniteTimeSpan };
+    }
+
+    /// <inheritdoc/>
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            foreach (string path in _files.Pending())
+            {
+                string id = Path.GetFileNameWithoutExtension(path);
+                _files.Claim(id);
+                using var operation = CancellationTokenSource.CreateLinkedTokenSource(stoppingToken);
+                operation.CancelAfter(TimeSpan.FromSeconds(45));
+                CatalogInvocationResult result;
+                try
+                {
+                    var request = await _files.ReadAsync<CatalogInvocationRequest>(id, ".working", operation.Token).ConfigureAwait(false);
+                    if (request.Id != id) throw new InvalidOperationException("Mismatched private identity.");
+                    result = await InvokeAsync(request, operation.Token).ConfigureAwait(false);
+                    if (DateTimeOffset.UtcNow >= request.ExpiresAt)
+                        throw new OperationCanceledException("Private invocation deadline elapsed.");
+                }
+                catch (Exception exception) when (!stoppingToken.IsCancellationRequested)
+                {
+                    // Never turn an admission/SDK/transport exception into an HTTP response.
+                    string diagnostic = exception.ToString();
+                    result = new(id, null, [], exception.GetType().Name, diagnostic[..Math.Min(diagnostic.Length, 8192)]);
+                }
+                try
+                {
+                    await _files.WriteAsync(id, ".response", result, operation.Token).ConfigureAwait(false);
+                }
+                catch (OperationCanceledException) when (!stoppingToken.IsCancellationRequested)
+                {
+                    // An expired private operation publishes no late HTTP result. The caller's
+                    // own complete deadline fails, and launcher cleanup retains/removes IPC files.
+                }
+            }
+            await Task.Delay(25, stoppingToken).ConfigureAwait(false);
+        }
+    }
+
+    /// <summary>Executes one finite callback under linked host/caller deadlines and real SDK generation fencing.</summary>
+    /// <param name="request">The verified private request.</param>
+    /// <param name="hostToken">The host lifetime deadline.</param>
+    /// <returns>An actual bounded HTTP result; SDK/transport failures propagate.</returns>
+    internal async Task<CatalogInvocationResult> InvokeAsync(CatalogInvocationRequest request, CancellationToken hostToken)
+    {
+        Validate(request);
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(hostToken);
+        deadline.CancelAfter(request.ExpiresAt - DateTimeOffset.UtcNow);
+        deadline.Token.ThrowIfCancellationRequested();
+        using var message = new HttpRequestMessage(HttpMethod.Post,
+            new Uri(_endpoint, "v1.0/invoke/" + request.AppId + "/method/" + request.Method))
+        {
+            Content = JsonContent.Create(request.Payload, options: CatalogInvocationFiles.Json),
+        };
+        await message.Content.LoadIntoBufferAsync(CatalogInvocationFiles.MaximumBytes, deadline.Token).ConfigureAwait(false);
+        if (request.Credential == CatalogInvocationCredential.HumanBearer)
+            message.Headers.Authorization = new AuthenticationHeaderValue("Bearer", request.Token);
+        else if (request.Credential == CatalogInvocationCredential.PublicIssuerWorkload)
+            message.Headers.Add(EventStoreWorkloadAuthenticationDefaults.AssertionHeaderName, request.Token);
+        else if (request.Credential is CatalogInvocationCredential.Workload or CatalogInvocationCredential.WrongOperation)
+        {
+            string operation = request.Method == "admin/operational-index-metadata" || request.Credential == CatalogInvocationCredential.WrongOperation
+                ? "domain-service:metadata" : "domain-service:project";
+            string assertion = await _issuer.IssueAsync(new(request.AppId, operation), deadline.Token).ConfigureAwait(false)
+                ?? throw new InvalidOperationException("Actual gateway issuer refused the selected assertion.");
+            message.Headers.Add(EventStoreWorkloadAuthenticationDefaults.AssertionHeaderName, assertion);
+        }
+        deadline.Token.ThrowIfCancellationRequested();
+        using HttpResponseMessage response = await _http.SendAsync(message, HttpCompletionOption.ResponseHeadersRead, deadline.Token).ConfigureAwait(false);
+        if (response.Content.Headers.ContentLength > CatalogInvocationFiles.MaximumBytes / 2) throw new IOException("Private response too large.");
+        using Stream stream = await response.Content.ReadAsStreamAsync(deadline.Token).ConfigureAwait(false);
+        using var body = new MemoryStream();
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = await stream.ReadAsync(buffer, deadline.Token).ConfigureAwait(false)) != 0)
+        {
+            if (body.Length + read > CatalogInvocationFiles.MaximumBytes / 2) throw new IOException("Private response too large.");
+            await body.WriteAsync(buffer.AsMemory(0, read), deadline.Token).ConfigureAwait(false);
+        }
+        deadline.Token.ThrowIfCancellationRequested();
+        if (DateTimeOffset.UtcNow >= request.ExpiresAt) throw new OperationCanceledException("Private invocation deadline elapsed.", deadline.Token);
+        return new(request.Id, (int)response.StatusCode, body.ToArray(), null);
+    }
+
+    /// <summary>Refuses expanded targets, credential modes, body kinds and stale or excessive deadlines.</summary>
+    /// <param name="request">The private request.</param>
+    internal void Validate(CatalogInvocationRequest request)
+    {
+        bool metadata = request.Method == "admin/operational-index-metadata" && _selection.MetadataAppIds.Contains(request.AppId, StringComparer.Ordinal);
+        bool projection = request.AppId == _selection.ProjectionAppId && request.Method is "project/v2" or "project/rebuild/v1";
+        bool suppliedToken = request.Credential is CatalogInvocationCredential.HumanBearer or CatalogInvocationCredential.PublicIssuerWorkload;
+        TimeSpan remaining = request.ExpiresAt - DateTimeOffset.UtcNow;
+        if ((!metadata && !projection) || !Enum.IsDefined(request.Credential)
+            || suppliedToken != !string.IsNullOrWhiteSpace(request.Token) || request.Token?.Length > 32768
+            || request.Token?.Any(character => char.IsControl(character) || char.IsWhiteSpace(character)) == true
+            || request.Payload.ValueKind != System.Text.Json.JsonValueKind.Object
+            || remaining <= TimeSpan.Zero || remaining > TimeSpan.FromSeconds(45)
+            || request.Credential == CatalogInvocationCredential.WrongOperation && !projection)
+            throw new InvalidOperationException("Private catalog request is outside the finite proof selection.");
+        _ = _files.PathFor(request.Id, ".working");
+    }
+
+    /// <inheritdoc/>
+    public override void Dispose()
+    {
+        _http.Dispose();
+        base.Dispose();
+    }
+}
diff --git a/src/Hexalith.EventStore.Testing/ProjectionDeliveryCompletionObserver.cs b/src/Hexalith.EventStore.Testing/ProjectionDeliveryCompletionObserver.cs
new file mode 100644
index 000000000..600595425
--- /dev/null
+++ b/src/Hexalith.EventStore.Testing/ProjectionDeliveryCompletionObserver.cs
@@ -0,0 +1,119 @@
+using System.Text.Json;
+
+using Hexalith.EventStore.Contracts.Identity;
+using Hexalith.EventStore.Contracts.Projections;
+using Hexalith.EventStore.Contracts.Security;
+using Hexalith.EventStore.Contracts.Streams;
+using Hexalith.EventStore.Server.Events;
+using Hexalith.EventStore.Server.Projections;
+
+namespace Hexalith.EventStore.Testing;
+
+/// <summary>Checks read-only seed delivery observations using the actual SDK receipt and fingerprint contracts; supplies no runtime authority.</summary>
+public static class ProjectionDeliveryCompletionObserver
+{
+    /// <summary>Gets the SDK checkpoint key for one exact source and enrolled projection.</summary>
+    public static string CheckpointKey(string tenant, string domain, string aggregate, string projection)
+    {
+        ProjectionKeySegments.Validate(projection, nameof(projection));
+        return ProjectionDeliveryStateKeys.GetStateKey(new(tenant, domain, aggregate), projection);
+    }
+
+    /// <summary>Gets the actual SDK lifecycle actor identity for one exact source and projection.</summary>
+    public static string LifecycleActorId(string tenant, string domain, string aggregate, string projection)
+    {
+        var identity = new AggregateIdentity(tenant, domain, aggregate);
+        ProjectionKeySegments.Validate(projection, nameof(projection));
+        return identity.ActorId + ":" + projection;
+    }
+
+    /// <summary>Requires an exact complete readable source prefix, SDK completion receipts, and explicit absent lifecycle state between unchanged positive epochs.</summary>
+    /// <remarks>Supports the unprotected metadata-v1 readable source layout and both SDK receipt fingerprint versions.
+    /// The caller observes actual storage absence and byte/version stability. Missing checkpoint or epoch bytes never establish completion.</remarks>
+    public static bool IsComplete(StreamReadPage source, string projection, ReadOnlyMemory<byte> checkpoint,
+        ReadOnlyMemory<byte> epochBefore, bool lifecycleStateAbsent, ReadOnlyMemory<byte> epochAfter,
+        JsonSerializerOptions serializer)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(serializer);
+        try
+        {
+            if (!lifecycleStateAbsent || epochBefore.Length is 0 or > 32 || !epochBefore.Span.SequenceEqual(epochAfter.Span)
+                || JsonSerializer.Deserialize<long>(epochBefore.Span, serializer) <= 0
+                || checkpoint.Length is 0 or > 1024 * 1024 || string.IsNullOrWhiteSpace(source.AggregateId)
+                || source.Events is not { Count: > 0 and <= 256 }
+                || source.Metadata is not { FromSequence: 0, ToSequence: null, IsTruncated: false, NextContinuationToken: null }
+                || source.Metadata.LatestSequence != source.Events.Count || source.Metadata.EventCount != source.Events.Count
+                || source.Metadata.LastSequenceReturned != source.Metadata.LatestSequence) return false;
+            var identity = new AggregateIdentity(source.Tenant, source.Domain, source.AggregateId);
+            if (StreamReadPageValidator.ValidateAndGetNextSequence(new(source.Tenant, source.Domain, source.AggregateId,
+                FromSequence: 0, PageSize: 256), source) != source.Metadata.LatestSequence
+                || source.Events.Any(item => item.MetadataVersion != 1 || string.IsNullOrWhiteSpace(item.CorrelationId)
+                    || item.PayloadVersion is < 1 or > 1024
+                    || item.ProtectionMetadata is { } protection
+                        && (protection.State != PayloadProtectionState.Unprotected || protection.MetadataVersion != 1))) return false;
+            ProjectionKeySegments.Validate(projection, nameof(projection));
+            using var document = JsonDocument.Parse(checkpoint, new JsonDocumentOptions { MaxDepth = 32 });
+            RejectDuplicateProperties(document.RootElement, serializer.PropertyNameCaseInsensitive);
+            string Name(string value) => serializer.PropertyNamingPolicy?.ConvertName(value) ?? value;
+            foreach (string name in new[] { "SchemaVersion", "WriterProtocolVersion", "TenantId", "Domain", "AggregateId", "ProjectionName",
+                "LastDeliveredSequence", "LastCompletedMessageId", "CompletedPrefixFingerprint", "CompletedReceipts", "FirstRetainedSequence",
+                "ActiveReservation", "UpdatedAt", "CompletedMessageIdDigests", "IdleBindingPending" })
+                if (!document.RootElement.TryGetProperty(Name(name), out _)) return false;
+            ProjectionDeliveryStateBody.Validate(checkpoint.Span, serializer, 256);
+            var state = document.RootElement.Deserialize<ProjectionDeliveryState>(serializer);
+            if (state is null || state.ActiveReservation is not null || state.IdleBindingPending is not null
+                || state.LastDeliveredSequence != source.Metadata.LatestSequence || state.FirstRetainedSequence != 1
+                || state.CompletedReceipts?.Count != source.Events.Count || state.CompletedMessageIdDigests?.Count != source.Events.Count
+                || !ProjectionDeliveryFingerprint.IsCanonical(state.CompletedPrefixFingerprint)) return false;
+            bool positionSensitive = state.CompletedPrefixFingerprint!.StartsWith("v2:", StringComparison.Ordinal);
+            var events = source.Events.Select(item => new ProjectionEventDto(item.EventTypeName, item.Payload,
+                item.SerializationFormat, item.SequenceNumber, item.Timestamp, item.CorrelationId!,
+                item.MessageId, item.UserId, item.GlobalPosition)
+            { MetadataVersion = item.MetadataVersion, StoredPayloadVersion = item.PayloadVersion }).ToArray();
+            ProjectionDeliveryFingerprintHistory history = ProjectionDeliveryFingerprint.ComputeHistory(identity, projection, events, positionSensitive);
+            if (!ProjectionDeliveryIdempotencyCoordinator.IsValidCurrentState(state, identity, projection, history.InitialFingerprint)
+                || state.CompletedPrefixFingerprint != history.PrefixFingerprint || state.LastCompletedMessageId != events[^1].MessageId) return false;
+            for (int index = 0; index < events.Length; index++)
+            {
+                ProjectionDeliveryReceipt actual = state.CompletedReceipts![index];
+                ProjectionDeliveryEventDigest expected = history.Events[index];
+                if (actual.SequenceNumber != expected.SequenceNumber || actual.MessageId != expected.MessageId
+                    || actual.EventFingerprint != expected.EventFingerprint || actual.PrefixFingerprint != expected.PrefixFingerprint
+                    || !ProjectionMessageIdDigest.TryParse(state.CompletedMessageIdDigests![index], out var digest)
+                    || digest != ProjectionMessageIdDigest.FromMessageId(expected.MessageId)) return false;
+            }
+            if (state.SchemaVersion == ProjectionDeliveryState.GuardSchemaVersion)
+            {
+                long epoch = JsonSerializer.Deserialize<long>(epochBefore.Span, serializer);
+                var guard = state.GuardEvidence;
+                var selection = guard?.OwnerProof?.Selection;
+                if (state.GuardEvidenceVersion != 1 || guard is null || guard.Source is null || guard.IdleLifecycleRevision != epoch
+                    || !SourceProofCodec.IsValid(guard.Source, identity, state.LastDeliveredSequence, guard.Source.RetainedFloor)
+                    || guard.Source.TenantId != source.Tenant || guard.Source.Domain != source.Domain || guard.Source.AggregateId != source.AggregateId
+                    || guard.Source.HeadSequence != state.LastDeliveredSequence || guard.Source.HeadMessageId != state.LastCompletedMessageId
+                    || guard.Source.Erased || selection is null || selection.TenantId != source.Tenant || selection.Domain != source.Domain
+                    || selection.AggregateId != source.AggregateId || selection.ProjectionName != projection
+                    || selection.AppliedSequence != state.LastDeliveredSequence || selection.MessageId != state.LastCompletedMessageId
+                    || !ProjectionDeliveryIdempotencyCoordinator.ValidOwnerProof(guard.OwnerProof, identity, projection)) return false;
+            }
+            return true;
+        }
+        catch (Exception failure) when (failure is JsonException or ArgumentException or InvalidOperationException or OverflowException) { return false; }
+    }
+
+    private static void RejectDuplicateProperties(JsonElement value, bool ignoreCase)
+    {
+        if (value.ValueKind == JsonValueKind.Object)
+        {
+            var names = new HashSet<string>(ignoreCase ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
+            foreach (JsonProperty property in value.EnumerateObject())
+            {
+                if (!names.Add(property.Name)) throw new JsonException("Duplicate delivery observation property.");
+                RejectDuplicateProperties(property.Value, ignoreCase);
+            }
+        }
+        else if (value.ValueKind == JsonValueKind.Array)
+            foreach (JsonElement item in value.EnumerateArray()) RejectDuplicateProperties(item, ignoreCase);
+    }
+}
diff --git a/src/Hexalith.EventStore.Testing/ProjectionDeliveryCutoverObserver.cs b/src/Hexalith.EventStore.Testing/ProjectionDeliveryCutoverObserver.cs
new file mode 100644
index 000000000..0c2b3fb81
--- /dev/null
+++ b/src/Hexalith.EventStore.Testing/ProjectionDeliveryCutoverObserver.cs
@@ -0,0 +1,163 @@
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+using Hexalith.EventStore.Server.Projections;
+using Hexalith.EventStore.Contracts.Identity;
+using Hexalith.EventStore.Contracts.Streams;
+
+namespace Hexalith.EventStore.Testing;
+
+/// <summary>Checks actual provider observations for a fresh disposable store before the supported authenticated writer cutover.</summary>
+/// <remarks>The caller must supply a complete atomic provider inventory. These checks never activate a writer or supply runtime authority.</remarks>
+public static class ProjectionDeliveryCutoverObserver
+{
+    /// <summary>Gets the actual SDK store-global writer protocol key.</summary>
+    public static string WriterProtocolKey => ProjectionDeliveryStateKeys.WriterProtocol;
+
+    /// <summary>Identifies SDK delivery, activation, checkpoint, reconciliation, and lifecycle keys that must be inventoried before fresh cutover.</summary>
+    public static bool IsRelevantStateKey(string key)
+    {
+        ArgumentNullException.ThrowIfNull(key);
+        return key.StartsWith("projection-activation:", StringComparison.Ordinal)
+            || key.StartsWith("projection-checkpoints", StringComparison.Ordinal)
+            || key.StartsWith("projection-delivery-", StringComparison.Ordinal)
+            || key.StartsWith("projection-rebuild", StringComparison.Ordinal)
+            || key.StartsWith("eventstore||ProjectionLifecycleActor||", StringComparison.Ordinal);
+    }
+
+    /// <summary>Requires explicit empty current ledgers and no other SDK delivery state; missing or malformed ledger fields never establish quiescence.</summary>
+    public static bool IsFreshStoreQuiescent(IReadOnlyDictionary<string, ReadOnlyMemory<byte>> observed, JsonSerializerOptions serializer)
+    {
+        ArgumentNullException.ThrowIfNull(observed);
+        ArgumentNullException.ThrowIfNull(serializer);
+        if (observed.Count > 256) return false;
+        try
+        {
+            string Name(string value) => serializer.PropertyNamingPolicy?.ConvertName(value) ?? value;
+            foreach (var (key, bytes) in observed)
+            {
+                if (!IsRelevantStateKey(key) || bytes.Length is 0 or > 1024 * 1024) return false;
+                if (key == "projection-delivery-retry:protocol")
+                {
+                    if (JsonSerializer.Deserialize<string>(bytes.Span, serializer) != "v2-ready:v1-writers-quiesced") return false;
+                    continue;
+                }
+                using JsonDocument document = JsonDocument.Parse(bytes);
+                if (Regex.IsMatch(key, "^projection-activation:outbox:v1:[0-3][0-9a-f]$", RegexOptions.CultureInvariant))
+                {
+                    if (!HasExactProperties(document.RootElement, Name("Items"), Name("LastRevision"))) return false;
+                    ProjectionActivationLedger? ledger = document.RootElement.Deserialize<ProjectionActivationLedger>(serializer);
+                    if (ledger?.Items is not { Count: 0 } || ledger.LastRevision < 0) return false;
+                }
+                else if (Regex.IsMatch(key, "^projection-delivery-retry:ledger:v2:[0-3][0-9a-f]$", RegexOptions.CultureInvariant))
+                {
+                    if (!HasExactProperties(document.RootElement, Name("Items"))) return false;
+                    ProjectionDeliveryRetryLedger? ledger = document.RootElement.Deserialize<ProjectionDeliveryRetryLedger>(serializer);
+                    if (ledger?.Items is not { Count: 0 }) return false;
+                }
+                else return false;
+            }
+            return true;
+        }
+        catch (Exception failure) when (failure is JsonException or ArgumentException or InvalidOperationException or OverflowException) { return false; }
+    }
+
+    /// <summary>Allows only one explicitly source-bound completed bootstrap scope in an otherwise fresh quiescent store.</summary>
+    /// <remarks>A historical non-zero row is accepted only before reconciliation; the caller must repeat with allowLegacy false before activating.</remarks>
+    public static bool IsQuiescentWithCompletedSource(IReadOnlyDictionary<string, ReadOnlyMemory<byte>> observed,
+        StreamReadPage source, string projection, string operatorId, bool allowLegacy, JsonSerializerOptions serializer)
+    {
+        ArgumentNullException.ThrowIfNull(observed);
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(serializer);
+        try
+        {
+            if (string.IsNullOrWhiteSpace(source.AggregateId)) return false;
+            var identity = new AggregateIdentity(source.Tenant, source.Domain, source.AggregateId);
+            string checkpoint = ProjectionDeliveryStateKeys.GetStateKey(identity, projection);
+            string migration = ProjectionCheckpointTracker.GetMigratedMarkerKey(identity, projection);
+            string work = ProjectionDeliveryStateKeys.GetReconciliationKey(identity, projection);
+            string actor = "eventstore||ProjectionLifecycleActor||" + identity.ActorId + ":" + projection;
+            string epochKey = actor + "||projection-lifecycle-epoch";
+            if (string.IsNullOrWhiteSpace(operatorId) || observed.ContainsKey(actor + "||projection-lifecycle")
+                || !observed.TryGetValue(checkpoint, out var body) || !observed.TryGetValue(epochKey, out var epoch)
+                || epoch.Length is 0 or > 32 || JsonSerializer.Deserialize<long>(epoch.Span, serializer) <= 0
+                || !(allowLegacy && IsLegacySourceCheckpoint(body, source, serializer))
+                    && !ProjectionDeliveryCompletionObserver.IsComplete(source, projection, body, epoch, true, epoch, serializer)) return false;
+            var remaining = observed.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
+            remaining.Remove(checkpoint); remaining.Remove(epochKey);
+            string Name(string value) => serializer.PropertyNamingPolicy?.ConvertName(value) ?? value;
+            if (remaining.Remove(migration, out var marker))
+            {
+                using var json = JsonDocument.Parse(marker);
+                if (!HasExactProperties(json.RootElement, Name("Migrated"))
+                    || json.RootElement.GetProperty(Name("Migrated")).ValueKind != JsonValueKind.True) return false;
+            }
+            if (remaining.Remove(work, out var reconciliation))
+            {
+                if (allowLegacy) return false;
+                using var workJson = JsonDocument.Parse(reconciliation);
+                if (!HasExactProperties(workJson.RootElement, Name("TenantId"), Name("Domain"), Name("AggregateId"), Name("ProjectionName"),
+                    Name("ReasonCode"), Name("ObservedSequence"), Name("DeliveryStateVersion"), Name("OperatorId"), Name("RecordedAt"))) return false;
+                ProjectionDeliveryReconciliationWork? receipt = workJson.RootElement.Deserialize<ProjectionDeliveryReconciliationWork>(serializer);
+                if (receipt is null || receipt.TenantId != source.Tenant || receipt.Domain != source.Domain
+                    || receipt.AggregateId != source.AggregateId || receipt.ProjectionName != projection
+                    || receipt.ReasonCode != "delivery_reconciled" || receipt.OperatorId != operatorId
+                    || receipt.ObservedSequence != source.Metadata.LatestSequence || receipt.DeliveryStateVersion != 1
+                    || receipt.RecordedAt == DateTimeOffset.MinValue || receipt.RecordedAt > DateTimeOffset.UtcNow
+                    || receipt.SourceGuardMaintenance is not null || receipt.QualifiedSourceGuard is not null) return false;
+            }
+            return IsFreshStoreQuiescent(remaining, serializer);
+        }
+        catch (Exception failure) when (failure is JsonException or ArgumentException or InvalidOperationException or OverflowException) { return false; }
+    }
+
+    /// <summary>Requires the actual historical five-field checkpoint to equal the exact readable bootstrap source head.</summary>
+    public static bool IsLegacySourceCheckpoint(ReadOnlyMemory<byte> bytes, StreamReadPage source, JsonSerializerOptions serializer)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        ArgumentNullException.ThrowIfNull(serializer);
+        if (bytes.Length is 0 or > 4096 || source.Events.Count == 0 || source.Metadata.LatestSequence != source.Events.Count) return false;
+        try
+        {
+            if (StreamReadPageValidator.ValidateAndGetNextSequence(new(source.Tenant, source.Domain, source.AggregateId, PageSize: 256), source)
+                != source.Metadata.LatestSequence) return false;
+            using var document = JsonDocument.Parse(bytes);
+            string Name(string value) => serializer.PropertyNamingPolicy?.ConvertName(value) ?? value;
+            if (!HasExactProperties(document.RootElement, Name("TenantId"), Name("Domain"), Name("AggregateId"),
+                Name("LastDeliveredSequence"), Name("UpdatedAt"))) return false;
+            ProjectionCheckpoint? row = document.RootElement.Deserialize<ProjectionCheckpoint>(serializer);
+            return row is not null && row.TenantId == source.Tenant && row.Domain == source.Domain
+                && row.AggregateId == source.AggregateId && row.LastDeliveredSequence == source.Metadata.LatestSequence;
+        }
+        catch (Exception failure) when (failure is JsonException or ArgumentException or InvalidOperationException or OverflowException) { return false; }
+    }
+
+    /// <summary>Binds the real persisted marker to the requested SDK source commit and the actual activation time window.</summary>
+    public static bool WriterProtocolMatches(ReadOnlyMemory<byte> bytes, string commit, DateTimeOffset notBefore,
+        DateTimeOffset notAfter, JsonSerializerOptions serializer)
+    {
+        ArgumentNullException.ThrowIfNull(serializer);
+        if (!Regex.IsMatch(commit, "^[0-9a-f]{40}$", RegexOptions.CultureInvariant) || bytes.Length is 0 or > 4096 || notBefore > notAfter) return false;
+        try
+        {
+            using JsonDocument document = JsonDocument.Parse(bytes);
+            string Name(string value) => serializer.PropertyNamingPolicy?.ConvertName(value) ?? value;
+            if (!HasExactProperties(document.RootElement, Name("SchemaVersion"), Name("WriterProtocolVersion"),
+                Name("CutoverCommit"), Name("ActivatedAt"), Name("IsCurrent"))) return false;
+            ProjectionDeliveryWriterProtocol? marker = document.RootElement.Deserialize<ProjectionDeliveryWriterProtocol>(serializer);
+            return marker is { IsCurrent: true } && marker.CutoverCommit == commit
+                && document.RootElement.GetProperty(Name("IsCurrent")).ValueKind == JsonValueKind.True
+                && marker.ActivatedAt >= notBefore && marker.ActivatedAt <= notAfter;
+        }
+        catch (Exception failure) when (failure is JsonException or ArgumentException or InvalidOperationException or OverflowException) { return false; }
+    }
+
+    private static bool HasExactProperties(JsonElement value, params string[] names)
+    {
+        if (value.ValueKind != JsonValueKind.Object) return false;
+        var expected = new HashSet<string>(names, StringComparer.Ordinal);
+        foreach (JsonProperty property in value.EnumerateObject()) if (!expected.Remove(property.Name)) return false;
+        return expected.Count == 0;
+    }
+}
