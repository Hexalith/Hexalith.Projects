+            or not (stat.S_ISDIR(entry.st_mode) if directory else stat.S_ISREG(entry.st_mode))):
+        raise RuntimeError("Private infrastructure ownership or permissions differ.")
+    identity = {"device": entry.st_dev, "inode": entry.st_ino}
