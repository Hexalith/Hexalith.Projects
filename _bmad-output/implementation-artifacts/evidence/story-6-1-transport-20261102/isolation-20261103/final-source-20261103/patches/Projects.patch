+            => scopes.All(scope => before[scope.Actor + "||projection-lifecycle-epoch"] is { } prior
+                && after[scope.Actor + "||projection-lifecycle-epoch"] is { } current && prior.ETag == current.ETag
+                && after[scope.Checkpoint] is { } checkpoint
