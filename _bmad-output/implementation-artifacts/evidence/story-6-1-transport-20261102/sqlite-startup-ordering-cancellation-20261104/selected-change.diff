+        if (buffered) logs.GetLogger(native).LogInformation("{NativeLine}", Ready);
+        DaprSqliteDiscoveryInitializationHealthCheck check = new(logs, new DistributedApplicationModel(new IResource[] { native }), native.Name, "peer");
