  "nuget_byte_capture_python": "import pathlib, urllib.request\nout = pathlib.Path(\"NEW_EMPTY_CAPTURE_DIRECTORY\")\nout.mkdir(exist_ok=False)\nfor role in [\"client\", \"contracts\", \"domainservice\", \"server\", \"servicedefaults\"]:\n    package = \"hexalith.eventstore.\" + role\n    url = \"https://api.nuget.org/v3-flatcontainer/\" + package + \"/index.json\"\n    request = urllib.request.Request(url, headers={\"Cache-Control\": \"no-cache\"})\n    with urllib.request.urlopen(request, timeout=30) as response:\n        (out / (package + \".index.json\")).write_bytes(response.read())\n",
