+        fixture.Proof.PreviousCompleted.ShouldBe(originalProof.PreviousCompleted);
+        fixture.Proof.Barrier.ShouldBe(new(invalid.Events.Max(item => item.SequenceNumber), "dispatch-invalid-classification"));
