<Project>
  <Target Name="Story65ReceiverPhaseLiveSourceSubstitution" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'Hexalith.EventStore.ServiceDefaults'">
    <ItemGroup>
      <_Story65Original Include="@(Compile)" Condition="'%(Compile.Identity)' == 'Routing/TechnicalHttpRouteCatalogReceiver.cs'" />
    </ItemGroup>
    <Error Condition="'@(_Story65Original->Count())' != '1'" Text="Private SDK original Compile count refused." />
    <ItemGroup>
      <Compile Remove="Routing/TechnicalHttpRouteCatalogReceiver.cs" />
      <Compile Include="/tmp/story65-receiver-phase-prep-20261107/TechnicalHttpRouteCatalogReceiver.private.cs" />
      <Compile Include="/tmp/story65-receiver-phase-prep-20261107/CaptureCounters.cs" />
      <Compile Include="/tmp/story65-receiver-phase-prep-20261107/ReceiverPhaseBootstrap.cs" />
    </ItemGroup>
  </Target>
</Project>
