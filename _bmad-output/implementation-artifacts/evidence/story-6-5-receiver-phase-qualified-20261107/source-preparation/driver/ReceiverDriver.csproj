    <TargetFramework>net10.0</TargetFramework><AssemblyName>Story65.ReceiverPhase.Driver</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <Optimize>false</Optimize><DebugType>portable</DebugType><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><Compile Include="*.cs" /><AssemblyMetadata Include="BuildingSdk" Value="$(NETCoreSdkVersion)" /></ItemGroup>
</Project>
