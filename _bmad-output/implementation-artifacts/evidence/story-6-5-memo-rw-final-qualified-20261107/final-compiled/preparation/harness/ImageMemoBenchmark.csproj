<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hexalith.EventStore.Server.Tests</AssemblyName>
    <RootNamespace>Story65.ImageMemo.Harness</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Hexalith.EventStore.ServiceDefaults">
      <HintPath>/home/administrator/projects/hexalith/projects/references/Hexalith.EventStore/src/Hexalith.EventStore.ServiceDefaults/bin/Debug/net10.0/Hexalith.EventStore.ServiceDefaults.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Hexalith.EventStore.Contracts">
      <HintPath>/home/administrator/projects/hexalith/projects/references/Hexalith.EventStore/src/Hexalith.EventStore.Contracts/bin/Debug/net10.0/Hexalith.EventStore.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="*.cs" />
    <Compile Include="../control/*.cs" Link="Control/%(Filename)%(Extension)" />
    <Compile Include="../candidate/*.cs" Link="Candidate/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireNativeQualifiedFinalTransferBinding" BeforeTargets="Restore;PrepareForBuild;CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/final-binding.json')" Text="Final production owner/native binding is required." />
    <Error Condition="'$(Story65FinalBindingSha256)' == '' Or '$(Story65QualifiedSdkSha256)' == ''" Text="Exact final binding and native-qualified SDK hashes are required." />
    <GetFileHash Files="$(MSBuildProjectDirectory)/final-binding.json" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FinalTransferBindingHash" />
    </GetFileHash>
    <GetFileHash Files="/home/administrator/projects/hexalith/projects/references/Hexalith.EventStore/src/Hexalith.EventStore.ServiceDefaults/bin/Debug/net10.0/Hexalith.EventStore.ServiceDefaults.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FinalTransferSdkHash" />
    </GetFileHash>
    <Error Condition="'%(_FinalTransferBindingHash.FileHash)' != '$(Story65FinalBindingSha256)'" Text="Final binding hash differs from the reviewed generation." />
    <Error Condition="'%(_FinalTransferSdkHash.FileHash)' != '$(Story65QualifiedSdkSha256)'" Text="Current SDK differs from the native-qualified production generation." />
  </Target>
</Project>
