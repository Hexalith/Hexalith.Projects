diff --git a/references/Hexalith.Tenants/Directory.Build.targets b/references/Hexalith.Tenants/Directory.Build.targets
index 1c4e7948..f0d0c6aa 100644
--- a/references/Hexalith.Tenants/Directory.Build.targets
+++ b/references/Hexalith.Tenants/Directory.Build.targets
@@ -1,8 +1,9 @@
 <Project>
 
-  <!-- Carry the owning EventStore source identity through every local project edge, including
-       indirect source graphs. Published package versions remain pinned in Directory.Build.props. -->
-  <ItemGroup Condition="'$(HexalithEventStoreFromSource)' == 'true'">
+  <!-- Carry the owning EventStore source identity through ordinary local project edges.
+       An active producer mapping owns dependency versions without per-edge overrides.
+       Published package versions remain pinned in Directory.Build.props. -->
+  <ItemGroup Condition="'$(HexalithEventStoreFromSource)' == 'true' and ('$(HexalithSourceMappingHash)' == '' or '$(HexalithSourceMappingApplies)' != 'true')">
     <ProjectReference Update="@(ProjectReference)">
       <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
     </ProjectReference>

