[
  "using GatewayBootstrap = Hexalith.PrivateCaptureCounter.GatewayControllerBootstrap;",
  "using GatewayStage = Hexalith.PrivateCaptureCounter.Stage;",
  "using GatewayAllocation = Hexalith.PrivateCaptureCounter.AllocationMode;",
  "        const GatewayStage Signature = GatewayStage.ComponentFile;",
  "        const GatewayStage Origin = GatewayStage.ComponentPolicy;",
  "        const GatewayStage CatalogAcquire = GatewayStage.AclFile;",
  "        const GatewayStage Admission = GatewayStage.SettingsEnumerationSortDictionary;",
  "        const GatewayStage Mediator = GatewayStage.AuthenticationSerialization;",
  "        const GatewayStage ResponseConstruction = GatewayStage.ActorBoundary;",
  "        const GatewayStage LeaseScope = GatewayStage.ResultTail;",
  "        using var gatewayCounters = GatewayBootstrap.Begin();",
  "        using var signatureTiming = gatewayCounters?.Stage(Signature, GatewayAllocation.None);",
  "        signatureTiming?.Dispose();",
  "        using var originTiming = gatewayCounters?.Stage(Origin, GatewayAllocation.None);",
  "        originTiming?.Dispose();",
  "        using var acquireTiming = gatewayCounters?.Stage(CatalogAcquire, GatewayAllocation.None);",
  "        acquireTiming?.Dispose();",
  "        using var leaseScopeTiming = gatewayCounters?.Stage(LeaseScope, GatewayAllocation.None);",
  "        using var admissionTiming = gatewayCounters?.Stage(Admission, GatewayAllocation.None);",
  "        admissionTiming?.Dispose();",
  "        using var mediatorTiming = gatewayCounters?.Stage(Mediator, GatewayAllocation.None);",
  "        mediatorTiming?.Dispose();",
  "        using var responseTiming = gatewayCounters?.Stage(ResponseConstruction, GatewayAllocation.None);"
]
