+            if (_closed || !_images.TryGetValue(assembly, out var entry)
+                || version is not null && !ReferenceEquals(version, entry.Version)
+                || offset < 0 || offset > entry.Bytes.Length - current.Length
+                || !current.SequenceEqual(entry.Bytes.AsSpan(offset, current.Length))) return false;
+            version = entry.Version;
+            return true;
+        }
+        finally { _gate.ExitReadLock(); }
+    }
