+    // Token never retains bytes/entry/assembly; every chunk is compared under short protection.
+    internal bool TryMatchNativeChunk(Assembly assembly, ReadOnlySpan<byte> current, int offset, ref object? version)
+    {
+        _gate.EnterReadLock();
+        try
