<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Hexalith.EventStore.ServiceDefaults</id>
    <version>5.2.0</version>
    <authors>Hexalith Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Hexalith/Hexalith.EventStore</projectUrl>
    <description>Shared service configuration for Hexalith.EventStore domain services — OpenTelemetry observability, health checks, HTTP resilience, and service discovery defaults. Consumed transitively by the Hexalith.EventStore.DomainService SDK (Epic A6).</description>
    <tags>eventsourcing dapr cqrs eventstore dotnet</tags>
    <repository type="git" url="https://github.com/Hexalith/Hexalith.EventStore" commit="8b6d5bee5217b3f4bbd8fd689ad887aca863961b" />
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="Hexalith.EventStore.Contracts" version="5.2.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Authentication.JwtBearer" version="11.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Http.Resilience" version="11.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.ServiceDiscovery" version="11.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.JsonWebTokens" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Protocols" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Protocols.OpenIdConnect" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Tokens" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Exporter.OpenTelemetryProtocol" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Extensions.Hosting" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Instrumentation.AspNetCore" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Instrumentation.Http" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Instrumentation.Runtime" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="ByteAether.Ulid" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="Hexalith.Commons.UniqueIds" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Abstractions" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Logging" version="8.23.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry" version="1.21.0" exclude="Build,Analyzers" />
        <dependency id="System.IdentityModel.Tokens.Jwt" version="8.23.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>