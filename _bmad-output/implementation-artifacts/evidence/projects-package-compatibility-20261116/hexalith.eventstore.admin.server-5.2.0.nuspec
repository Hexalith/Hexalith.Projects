        <dependency id="Hexalith.McpCli.Abstractions" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.OpenApi" version="3.11.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
