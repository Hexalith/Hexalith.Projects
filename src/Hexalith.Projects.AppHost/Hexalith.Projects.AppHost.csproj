<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <UserSecretsId>hexalith-projects</UserSecretsId>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\references\Hexalith.Platform\DaprSelfHostedMtls.cs')">$(MSBuildThisFileDirectory)..\..\references\Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Hexalith.Platform\DaprSelfHostedMtls.cs')">$(MSBuildThisFileDirectory)..\..\..\Hexalith.Platform</HexalithPlatformRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\references\Hexalith.Builds\src\libraries\Hexalith.Builds.Tooling')">$(MSBuildThisFileDirectory)..\..\references\Hexalith.Builds</HexalithBuildsRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Hexalith.Builds\src\libraries\Hexalith.Builds.Tooling')">$(MSBuildThisFileDirectory)..\..\..\Hexalith.Builds</HexalithBuildsRoot>
    <DefineConstants Condition="'$(UseHexalithProjectReferences)' == 'true'">$(DefineConstants);SUPPORTED_PROJECT_READ_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Projects.Aspire\Hexalith.Projects.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Hexalith.Projects.Server\Hexalith.Projects.Server.csproj" />
    <ProjectReference Include="..\Hexalith.Projects.UI\Hexalith.Projects.UI.csproj" />
    <ProjectReference Include="..\Hexalith.Projects.Workers\Hexalith.Projects.Workers.csproj" />
    <ProjectReference Include="..\..\tests\Hexalith.Projects.E2E.Fixtures\Hexalith.Projects.E2E.Fixtures.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\tests\Hexalith.Projects.ReadAuthority\Hexalith.Projects.ReadAuthority.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj" IsAspireProjectResource="false" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <!-- The two executable references below remain Aspire resources in every mode. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore\Hexalith.EventStore.csproj" />
    <ProjectReference Include="$(HexalithTenantsRoot)\src\Hexalith.Tenants\Hexalith.Tenants.csproj" />
    <ProjectReference Include="$(HexalithFoldersRoot)\src\Hexalith.Folders.Server\Hexalith.Folders.Server.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithFoldersRoot)\src\Hexalith.Folders.Workers\Hexalith.Folders.Workers.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <Compile Include="$(HexalithPlatformRoot)\DaprSelfHostedMtls.cs" Link="Platform\DaprSelfHostedMtls.cs" />
    <Compile Include="$(HexalithPlatformRoot)\DaprSelfHostedMtlsSubscriber.cs" Link="Platform\DaprSelfHostedMtlsSubscriber.cs" />
    <ProjectReference Include="$(HexalithFoldersRoot)\src\Hexalith.Folders.EventStore\Hexalith.Folders.EventStore.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="$(HexalithBuildsRoot)\src\libraries\Hexalith.Builds.Tooling\Hexalith.Builds.Tooling.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="Hexalith.EventStore.Aspire" Condition="'$(UseHexalithProjectReferences)' != 'true'" />
  </ItemGroup>
</Project>
