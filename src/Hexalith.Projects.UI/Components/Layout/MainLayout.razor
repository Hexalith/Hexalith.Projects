@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Hexalith.Projects.Client.ProjectsReadRouteSelection ReadRoute
@using Hexalith.FrontComposer.Shell.Components.Layout

<FrontComposerShell @key="_scope">
    <Navigation>
        @if (ReadRoute.Mode == "Supported" || new Uri(Navigation.Uri).AbsolutePath.StartsWith("/inspect/", StringComparison.Ordinal))
        { <ProjectNavigation /> }
        else if (ReadRoute.Mode == "LegacyRollback") { <LegacyProjectNavigation /> }
    </Navigation>
    <ChildContent>
        @Body
    </ChildContent>
</FrontComposerShell>

@code {
    [CascadingParameter] public Task<AuthenticationState>? Authentication { get; set; }
    private (string? Actor, string? Tenant, string? Session) _scope;
    protected override async Task OnParametersSetAsync()
    {
        var request = Authentication;
        if (request is not { IsCompletedSuccessfully: true }) _scope = default;
        AuthenticationState? state = request is null ? null : await request;
        if (!ReferenceEquals(request, Authentication)) return;
        _scope = (state?.User.FindFirst("sub")?.Value,
            state?.User.FindFirst("eventstore:current-tenant")?.Value,
            state?.User.FindFirst("hexalith:frontcomposer:token-session")?.Value);
    }
}
