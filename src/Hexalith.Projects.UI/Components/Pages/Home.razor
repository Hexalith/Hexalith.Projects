@page "/inspect/projects"
@page "/inspect/projects/warnings"
@using Hexalith.Projects.Contracts.Queries
@using Hexalith.Projects.Contracts.Ui
@using Hexalith.Projects.UI.Diagnostics
@inject IProjectWarningsDashboardSource WarningsDashboard
@implements IDisposable

<section class="project-inventory" aria-labelledby="project-inventory-heading">
    <h1 id="project-inventory-heading">Projects</h1>
    <FluentText data-testid="project-inventory-tenant-scope">@(_result?.TenantScope ?? "server-derived tenant")</FluentText>
    <FluentText>Safe Metadata is the default. Descriptive and quarantine inspection require separate authorization and are audited.</FluentText>
    @* Separate groups keep each 16px checkbox clear of the filter buttons (WCAG 2.2 target size). *@
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
        <FluentStack Wrap="true" role="group" aria-label="Lifecycle filter">
            <FluentButton role="button" OnClick="@(() => SetLifecycleAsync(null))" data-testid="project-inventory-filter-all">All lifecycle states</FluentButton>
            <FluentButton role="button" OnClick="@(() => SetLifecycleAsync("Active"))" data-testid="project-inventory-filter-active">Active</FluentButton>
            <FluentButton role="button" OnClick="@(() => SetLifecycleAsync("Archived"))" data-testid="project-inventory-filter-archived">Archived</FluentButton>
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalS)" role="group" aria-label="Inspection mode">
            <FluentCheckbox role="checkbox" aria-checked="@((_descriptive || _quarantined).ToString().ToLowerInvariant())" aria-disabled="@_quarantined.ToString().ToLowerInvariant()" Label="Descriptive inspection (audited; required in quarantine)" Value="@(_descriptive || _quarantined)" Disabled="@_quarantined" ValueChanged="SetDescriptiveAsync" data-testid="project-inventory-inspection" />
            <FluentCheckbox role="checkbox" aria-checked="@_quarantined.ToString().ToLowerInvariant()" Label="Quarantine inventory (Administrator inspection, audited names)" Value="@_quarantined" ValueChanged="SetQuarantineAsync" data-testid="project-inventory-quarantine" />
        </FluentStack>
    </FluentStack>
    @if (_quarantined) { <FluentText role="status">Administrator quarantine inspection may disclose names and excludes ordinary Projects. It grants no context or Conversation-start authority.</FluentText> }
    @if (_loading) { <ProjectFeedbackView Feedback="@ProjectConsoleFeedback.Loading("project_inventory_loading")" /> }
    else if (_result?.Feedback is not null) { <ProjectFeedbackView Feedback="@_result.Feedback" /> }
    else if (_result?.Inventory is { } page)
    {
        <FluentAccordion>
            <FluentAccordionItem Header="Inventory" Expanded="true">
                <FluentText>Lifecycle filter: @(_lifecycle ?? "All")</FluentText>
                <FluentText>Rows on this page: @(page.Rows.Count). Warning history is unavailable on this read surface.</FluentText>
                @if (page.Rows.Count == 0) { <FluentText data-testid="project-inventory-empty">No Projects observed on this page. Check enumeration evidence.</FluentText> }
                <div data-testid="project-inventory-grid">
                    @foreach (ProjectInventoryRowProjection row in page.Rows)
                    {
                        <FluentCard data-testid="project-inventory-row">
                            <FluentStack Orientation="Orientation.Vertical">
                                <FluentLink role="link" Href="@ProjectLink(row.ProjectId)" aria-label="@($"Open project {(string.IsNullOrWhiteSpace(row.Name) ? row.ProjectId : row.Name)}")" data-testid="project-inventory-row-link">@(string.IsNullOrWhiteSpace(row.Name) ? row.ProjectId : row.Name)</FluentLink>
                                <FluentText>Project ID: @row.ProjectId</FluentText>
                                <FluentText>Lifecycle: @row.Lifecycle; Project Folder: @row.ProjectFolderAvailability</FluentText>
                                @if (page.Page?.Items.FirstOrDefault(item => item.ProjectId == row.ProjectId)?.Snapshot is { } snapshot) { <ProjectReadSnapshot Snapshot="snapshot" TestId="project-inventory-row-snapshot" /> }
                            </FluentStack>
                        </FluentCard>
                    }
                </div>
                <FluentButton role="button" OnClick="NextPageAsync" Disabled="@(!page.HasMore || page.Cursor is null)" data-testid="project-inventory-next">Next page</FluentButton>
                <FluentButton role="button" OnClick="@(() => LoadAsync(null))" data-testid="project-inventory-restart">Start over</FluentButton>
            </FluentAccordionItem>
            <FluentAccordionItem Header="Enumeration evidence">
                @if (page.Snapshot is { } snapshot) { <ProjectReadSnapshot Snapshot="snapshot" TestId="project-inventory-page-snapshot" /> }
                <FluentText>Enumeration describes this authorized page. Each row has its own observation; none grants context or Conversation-start authority.</FluentText>
            </FluentAccordionItem>
        </FluentAccordion>
    }
</section>
@code {
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _loadCancellation;
    private int _loadGeneration;
    private ProjectWarningsDashboardLoadResult? _result;
    private bool _loading = true;
    private string? _lifecycle;
    private bool _descriptive;
    private bool _quarantined;
    protected override Task OnInitializedAsync() => LoadAsync(null);
    private async Task LoadAsync(string? cursor)
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        CancellationTokenSource request = _loadCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        int generation = ++_loadGeneration;
        _loading = true;
        _result = null;
        try { var result = await WarningsDashboard.LoadPageAsync(new ListProjectsQuery(_lifecycle, cursor, 50, _descriptive, _quarantined), request.Token);
            if (generation == _loadGeneration && !request.IsCancellationRequested) _result = result; }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally { if (generation == _loadGeneration) _loading = false; }
    }
    private Task NextPageAsync() => LoadAsync(_result?.Inventory?.Cursor);
    private Task SetLifecycleAsync(string? value) { _lifecycle = value; return LoadAsync(null); }
    private Task SetDescriptiveAsync(bool value) { _descriptive = value; return LoadAsync(null); }
    private Task SetQuarantineAsync(bool value) { _quarantined = value; return LoadAsync(null); }
    private string ProjectLink(string id) => $"/inspect/projects/{Uri.EscapeDataString(id)}?descriptive={_descriptive.ToString().ToLowerInvariant()}&quarantined={_quarantined.ToString().ToLowerInvariant()}";
    public void Dispose() { ++_loadGeneration; _loadCancellation?.Cancel(); _loadCancellation?.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
