@page "/inspect/projects/{ProjectId}"
@using Hexalith.Projects.Contracts.Models
@using Hexalith.Projects.Contracts.Queries
@using Hexalith.Projects.UI.Diagnostics
@inject IProjectDetailSource Details
@implements IDisposable

<section class="project-detail-inspector" data-testid="project-detail-inspector" aria-labelledby="project-detail-heading" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <h1 id="project-detail-heading">Project @ProjectId</h1>
    <FluentText>Tenant: @(_result?.TenantScope ?? "server-derived tenant"); read only</FluentText>
    @if (Quarantined) { <FluentText role="status">Administrator quarantine inspection may disclose an audited name. This Project remains unavailable for context or Conversation start.</FluentText> }
    <FluentCheckbox role="checkbox" aria-checked="@((_descriptive || Quarantined).ToString().ToLowerInvariant())" aria-disabled="@Quarantined.ToString().ToLowerInvariant()" Label="Descriptive inspection (separately authorized and audited; required in quarantine)" Value="@(_descriptive || Quarantined)" Disabled="@Quarantined" ValueChanged="InspectAsync" data-testid="project-detail-inspection" />
    <FluentButton role="button" OnClick="LoadAsync" data-testid="project-detail-reread">Re-read supported observations</FluentButton>
    @if (_loading) { <ProjectFeedbackView Feedback="@ProjectConsoleFeedback.Loading("project_detail_loading")" /> }
    else if (_result?.Open is { } opened)
    {
        <FluentAccordion>
            <FluentAccordionItem Header="Open observation" Expanded="true">
                <FluentText>Lifecycle: @opened.LifecycleState</FluentText>
                <FluentText>Name: @(opened.Name ?? "Not disclosed")</FluentText>
                <FluentText>Description: @(opened.Description ?? "Not disclosed")</FluentText>
                <FluentText>Setup metadata: @(opened.SetupMetadata ?? "Not disclosed")</FluentText>
                @if (opened.CreatedAt != default) { <FluentText>Created: @opened.CreatedAt.ToString("O"); Updated: @opened.UpdatedAt.ToString("O")</FluentText> }
                @if (opened.Setup is { } setup)
                {
                    <FluentText>Goals: @string.Join("; ", setup.Goals)</FluentText>
                    <FluentText>User instructions: @string.Join("; ", setup.UserInstructions)</FluentText>
                    <FluentText>Preferred sources: @string.Join(", ", setup.PreferredSourceKinds); Excluded sources: @string.Join(", ", setup.ExcludedSourceKinds)</FluentText>
                }
                <ProjectReadSnapshot Snapshot="opened.Snapshot" TestId="project-open-snapshot" />
                @foreach (ProjectReadReference reference in opened.References)
                {
                    <FluentText data-testid="project-open-reference">@reference.ReferenceKind: @reference.FolderId @reference.FileReferenceId @reference.MemoryReferenceId@if (reference.DisplayName is { Length: > 0 } label) { <FluentText data-testid="project-open-reference-label"> — @label</FluentText> }; @reference.ReferenceState; @reference.ReasonCode; Observed: @reference.ObservedAt.ToString("O")</FluentText>
                }
            </FluentAccordionItem>
            <FluentAccordionItem Header="Context observation">
                @if (_result.Context is { } context)
                {
                    <ProjectReadSnapshot Snapshot="context.Snapshot" TestId="project-context-snapshot" />
                    <FluentText>Lifecycle: @context.Lifecycle; Setup: @(context.Setup is null ? "Omitted" : "Included")</FluentText>
                    @foreach (ProjectContextReference reference in Included(context))
                    {
                        <FluentText data-testid="project-context-reference">@reference.ReferenceKind: @reference.ReferenceId; @reference.ReferenceState; @reference.ReasonCode; Observed: @reference.ObservedAt.ToString("O")</FluentText>
                    }
                    @foreach (ProjectContextExclusion excluded in context.Excluded)
                    {
                        <FluentText data-testid="project-context-omission">Omitted @excluded.ReferenceKind: @excluded.ReferenceId; @excluded.ReferenceState; @excluded.ReasonCode; @excluded.FailedCheck; @excluded.Diagnostic</FluentText>
                    }
                }
                else if (_result.ContextFeedback is { } feedback) { <ProjectFeedbackView Feedback="feedback" /> }
            </FluentAccordionItem>
            <FluentAccordionItem Header="Conversation-start observation">
                @if (_result.Start is { } start)
                {
                    <FluentStack Orientation="Orientation.Vertical" data-testid="project-start-snapshot">
                        <FluentText>State: @start.Snapshot.ResponseState</FluentText>
                        <FluentText>As of: @start.Snapshot.AsOf.ToString("O")</FluentText>
                        <FluentText>Project version: @start.Snapshot.ProjectVersion</FluentText>
                        @foreach (ConversationStartComponent component in start.Snapshot.Components)
                        { <FluentText>@component.Name — Included: @component.Included; Freshness: @component.Freshness; Reason: @component.Reason</FluentText> }
                        <FluentText>Recovery guidance: @string.Join(", ", start.Snapshot.RecoveryActions)</FluentText>
                        <FluentText>Setup: @(start.Setup is null ? "Omitted" : "Included"); Linked source policy: @start.Setup?.LinkedSourcePolicy</FluentText>
                    </FluentStack>
                }
                else if (_result.StartFeedback is { } feedback) { <ProjectFeedbackView Feedback="feedback" /> }
                <FluentText>Owner evidence and first-response authorization retain their delivered limits. Open and context observations do not grant Conversation-start authority.</FluentText>
            </FluentAccordionItem>
            <FluentAccordionItem Header="Project suggestions"><ProjectResolutionTraceWorkbench ProjectId="opened.ProjectId" /></FluentAccordionItem>
            <FluentAccordionItem Header="Capabilities">
                <FluentText>Audit history is unavailable on this read surface. Recovery guidance is informational. Re-read uses supported Get operations; Refresh is unavailable.</FluentText>
            </FluentAccordionItem>
        </FluentAccordion>
    }
    else if (_result?.Feedback is { } feedback) { <ProjectFeedbackView Feedback="feedback" /> }
</section>
@code {
    [Parameter] public string? ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "descriptive")] public bool Descriptive { get; set; }
    [SupplyParameterFromQuery(Name = "quarantined")] public bool Quarantined { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _loadCancellation;
    private int _loadGeneration;
    private ProjectDetailLoadResult? _result;
    private bool _loading = true;
    private bool _descriptive;
    protected override async Task OnParametersSetAsync() { _descriptive = Descriptive; await LoadAsync(); }
    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        CancellationTokenSource request = _loadCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        int generation = ++_loadGeneration;
        _loading = true; _result = null;
        try { var result = string.IsNullOrWhiteSpace(ProjectId) ? ProjectDetailLoadResult.FromFeedback(ProjectConsoleFeedback.FailClosed("safe_denial"))
            : await Details.InspectAsync(ProjectId, _descriptive, Quarantined, request.Token);
            if (generation == _loadGeneration && !request.IsCancellationRequested) _result = result; }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally { if (generation == _loadGeneration) _loading = false; }
    }
    private Task InspectAsync(bool value) { _descriptive = value; return LoadAsync(); }
    private static IEnumerable<ProjectContextReference> Included(ProjectContextReadResponse context)
        => (context.ProjectFolder is { } folder ? new[] { folder } : []).Concat(context.Conversations).Concat(context.FileReferences).Concat(context.MemoryReferences);
    public void Dispose() { ++_loadGeneration; _loadCancellation?.Cancel(); _loadCancellation?.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
